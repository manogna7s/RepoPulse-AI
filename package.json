{
  "name": "repopulse-ai",
  "version": "1.0.0",
  "private": true,
  "description": "AI-powered GitHub repository insights",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names client,server \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "npm --prefix client run dev",
    "dev:server": "npm --prefix server run dev",
    "build": "npm --prefix client run build",
    "start": "npm --prefix server start",
    "lint": "npm --prefix client run lint"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "concurrently": "^10.0.4"
  },
  "dependencies": {
    "mongodb": "^7.5.0"
  }
}
