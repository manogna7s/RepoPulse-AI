# Server runtime
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Atlas connection string (never commit the real value).
# Tip: include a database name, e.g. ...mongodb.net/repopulse?retryWrites=true&w=majority
MONGODB_URI=

# GitHub Personal Access Token for guest public-repo analysis.
GITHUB_TOKEN=

# GitHub OAuth App (Settings → Developer settings → OAuth Apps)
# Homepage URL: http://localhost:5173
# Authorization callback URL: http://localhost:5000/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback
# repo scope is required to analyze private repositories the user can access.
GITHUB_OAUTH_SCOPES=read:user repo

# Session JWT + AES key for encrypting stored GitHub tokens (32+ random chars each).
JWT_SECRET=
JWT_EXPIRES_IN=7d
TOKEN_ENCRYPTION_KEY=

# Google Gemini API key (never commit the real value).
GEMINI_API_KEY=

# Optional
# GEMINI_MODEL=gemini-3.5-flash
# EXTRA_CORS_ORIGINS=https://your-preview.vercel.app
# REQUEST_TIMEOUT_MS=120000
