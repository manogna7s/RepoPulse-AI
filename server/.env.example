# Server runtime
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Atlas connection string (never commit the real value).
# Tip: include a database name, e.g. ...mongodb.net/repopulse?retryWrites=true&w=majority
MONGODB_URI=

# GitHub Personal Access Token (never commit the real value).
# Public-repo read access is enough for analysis.
GITHUB_TOKEN=

# Google Gemini API key (never commit the real value).
# Used only to EXPLAIN heuristic scores — not to calculate them.
GEMINI_API_KEY=

# Optional
# GEMINI_MODEL=gemini-2.5-pro
# EXTRA_CORS_ORIGINS=https://your-preview.vercel.app
# REQUEST_TIMEOUT_MS=120000
