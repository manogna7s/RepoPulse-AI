# Server runtime
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# GitHub Personal Access Token (never commit the real value).
# How to create one:
#   1. GitHub → Settings → Developer settings → Personal access tokens
#   2. Generate a fine-grained token (recommended) OR a classic token
#   3. For READING PUBLIC repositories only:
#        Fine-grained: Repository access = Public repositories
#                      Permissions → Repository permissions → Metadata: Read-only
#        Classic: no special scopes are required for public read access
#   4. Paste the token below (and into your local .env — never into git)
GITHUB_TOKEN=

# Add your MongoDB Atlas connection string.
# Tip: include a database name, e.g. ...mongodb.net/repopulse?retryWrites=true&w=majority
# If the path is missing, the server injects /repopulse automatically.
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/repopulse?retryWrites=true&w=majority

# Google Gemini API key (never commit the real value).
# Used only to EXPLAIN heuristic scores — not to calculate them.
GEMINI_API_KEY=your_gemini_api_key
# Optional model override (default: gemini-2.5-pro)
GEMINI_MODEL=gemini-2.5-pro
